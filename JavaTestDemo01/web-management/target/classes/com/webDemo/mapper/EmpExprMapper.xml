<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.webDemo.mapper.EmpExprMapper">


    <insert id="addEmpExpr">
        insert emp_expr(begin, end, company, job, emp_id) VALUES
        <foreach collection="empExprList" item="empExpr" separator=",">
            (#{empExpr.begin}, #{empExpr.end}, #{empExpr.company}, #{empExpr.job}, #{empExpr.empId})

        </foreach>
    </insert>

    <delete id="deleteEmpExp">
        delete from emp_expr where emp_id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
